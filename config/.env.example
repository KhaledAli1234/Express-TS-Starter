PORT=3000
MOOD="development"
APPLICATION_NAME="ExpressTSStarter"
DB_URI="mongodb://localhost:27017/ExpressTSStarter"

# EMAIL 
EMAIL="your-email@gmail.com"
EMAIL_PASSWORD="your-gmail-app-password"

# HASH
SALT_ROUND=10

# TOKEN 
ACCESS_USER_TOKEN_SIGNATURE="change-me"
ACCESS_SYSTEM_TOKEN_SIGNATURE="change-me"

